# Server Configuration
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Database Configuration (SQLite by default, PostgreSQL-ready)
DATABASE_URL=sqlite:///./taskmind.db
# PostgreSQL alternative:
# DATABASE_URL=postgresql://taskmind:taskmind@localhost:5432/taskmind

# Security & Authentication (JWT)
SECRET_KEY=change_this_to_a_secure_random_string_for_jwt
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI / LLM Provider Configuration
# Supported providers: "mock", "openai", "gemini", "anthropic"
LLM_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Voice Interface (Whisper STT & Edge Neural TTS)
VOICE_TTS_VOICE=en-US-JennyNeural
VOICE_STT_PROVIDER=auto
VOICE_MAX_RESPONSE_SENTENCES=2

# Telegram Bot Notifications (python-telegram-bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=

# Default Timezone for app users
DEFAULT_TIMEZONE=UTC
